# TradingView API Configuration
# For paid TradingView accounts

# Option 1: TradingView WebSocket (Real-time streaming)
TRADINGVIEW_USERNAME=your_username
TRADINGVIEW_PASSWORD=your_password

# Option 2: TradingView API Token (if available)
TRADINGVIEW_API_TOKEN=your_api_token_here

# Data Provider Settings
DATA_PROVIDER=tradingview  # Options: tradingview, yahoo, alphavantage
RATE_LIMIT_REQUESTS_PER_MINUTE=60  # Adjust based on your plan
CACHE_TTL_SECONDS=60  # Cache duration for price data

# Exchange Settings
DEFAULT_EXCHANGE=NSE
DEFAULT_SCREENER=india
